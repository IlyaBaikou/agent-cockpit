# Configure real random secrets in the deployment secret store, never here.
NODE_ENV=production
PORT=4317
HUB_HOST=0.0.0.0
DATABASE_URL=postgresql://user:password@localhost:5432/agenthub
# Bootstrap employees; use distinct randomly generated tokens, at least 32 bytes.
# HUB_CONTROL_TOKENS=admin:<random-secret>,colleague:<different-random-secret>
# Required by retained v1 compatibility (do not reuse a controller token).
# HUB_RUNNER_TOKENS=legacy-codex:codex:<different-random-secret>
AGENT_TIMEOUT_MS=300000
